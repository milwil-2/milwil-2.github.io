---
import ThemeToggle from './ThemeToggle.astro';

const LINKEDIN = "https://www.linkedin.com/in/milanwillett/";
---

<header>
  <div class="title-row">
    <h1>Milan Willett</h1>
    <ThemeToggle />
  </div>
  <p class="bio">
    UC Berkeley - data science with an emphasis in economics. Building with
    AI, ML, and computer vision. Off the keyboard you'll find me climbing,
    sailing, or drinking matcha.
  </p>
  <nav>
    <a href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a>
  </nav>
</header>

<style>
  header {
    margin-bottom: 3rem;
  }

  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 500;
    font-style: italic;
    line-height: 1.2;
    color: var(--text);
  }

  .bio {
    color: var(--muted);
    max-width: 52ch;
    margin-bottom: 1.25rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }

  nav a {
    color: var(--muted);
  }
</style>
